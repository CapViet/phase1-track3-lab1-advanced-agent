# Copy to .env and fill in for `--mode real`. Defaults target local Ollama (free).
LLM_PROVIDER=ollama          # ollama | openai | gemini | anthropic
LLM_MODEL=qwen2.5:3b         # e.g. gpt-4o-mini, gemini-2.0-flash, claude-haiku-4-5
OLLAMA_HOST=http://localhost:11434

# Hosted providers (only needed if you switch LLM_PROVIDER):
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
